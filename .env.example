# ---------------------------------------------------------------------------
# Modelo de configuração. Copie para `.env` e ajuste.
#
# O arquivo `.env` NUNCA deve ser versionado — já está no .gitignore.
# Para rodar localmente, nenhuma destas variáveis é obrigatória: os padrões
# fazem a aplicação funcionar sem banco externo e sem chave de API.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Banco de dados
#
# Sem DATABASE_URL, a aplicação usa PGlite — o próprio PostgreSQL compilado
# para WebAssembly, gravando em disco local. Serve para desenvolvimento e
# demonstração, mas é de processo único: não use em produção.
#
# Em produção, defina a URL do PostgreSQL gerenciado:
#   DATABASE_URL="postgresql://usuario:senha@host:5432/icam"
#
# No Neon (plano gratuito), copie a opção "Pooled connection" e mantenha o
# sslmode ao final:
#   DATABASE_URL="postgresql://usuario:senha@ep-nome-123-pooler.us-east-1.aws.neon.tech/icam?sslmode=require"
# ---------------------------------------------------------------------------
# DATABASE_URL=
PGLITE_CAMINHO=./dados-locais
# Provedores gerenciados exigem TLS. Defina como false apenas em rede interna.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Sessão — OBRIGATÓRIO em produção
#
# Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Trocar este valor invalida todas as sessões abertas. A aplicação recusa
# iniciar em produção se o segredo tiver menos de 32 caracteres ou for o valor
# de exemplo abaixo.
# ---------------------------------------------------------------------------
SESSAO_SEGREDO=troque-este-valor-em-producao-com-32-bytes-aleatorios

# ---------------------------------------------------------------------------
# Provedor de IA
#
#   deterministico -> heurísticas locais auditáveis, sem chamada externa (padrão)
#   anthropic      -> exige ANTHROPIC_API_KEY e autorização explícita de envio
#
# Sem IA_ENVIO_EXTERNO_AUTORIZADO=true, nenhuma chamada externa é feita, mesmo
# com a chave configurada. É uma trava proposital.
# ---------------------------------------------------------------------------
PROVEDOR_IA=deterministico
ANTHROPIC_API_KEY=
MODELO_IA=claude-sonnet-5
IA_ENVIO_EXTERNO_AUTORIZADO=false
IA_RESIDENCIA_DADOS=nao_definida
IA_POLITICA_NAO_TREINAMENTO=exigida

# ---------------------------------------------------------------------------
# Semeadura inicial (usado só por `npm run db:seed`)
# ---------------------------------------------------------------------------
ORGANIZACAO_ID=org-demo
ORGANIZACAO_NOME=Organização de demonstração
ADMIN_NOME=Administrador da plataforma
ADMIN_EMAIL=admin@exemplo.com
# Se ficar vazio, o comando gera uma senha e a exibe uma única vez.
ADMIN_SENHA=

# Equipe criada junto com o administrador — uma pessoa por linha:
#   email | Nome da Pessoa | papel | sensivel
#
# Papéis: administrador, gestor, investigador, revisor, aprovador, leitor.
# O papel é opcional (padrão investigador). Escreva `sensivel` no fim apenas
# para quem precisa ver nome, matrícula e dados de saúde.
# Cada senha provisória é gerada e exibida uma única vez, na saída do comando.
# Rodar de novo não duplica ninguém: quem já existe é apenas informado.
#
# USUARIOS_INICIAIS="maria@empresa.com | Maria Silva | investigador
# joao@empresa.com | João Souza | aprovador | sensivel"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Custo do hash de senha. Reduzir acelera a suíte de testes, e é IGNORADO
# quando NODE_ENV=production — um custo baixo em produção seria falha de
# segurança silenciosa.
# SENHA_CUSTO_N=4096
